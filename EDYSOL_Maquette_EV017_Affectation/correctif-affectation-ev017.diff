diff --git a/maquette_interactive/css/espace.css b/maquette_interactive/css/espace.css
index 01b192b..21fe401 100644
--- a/maquette_interactive/css/espace.css
+++ b/maquette_interactive/css/espace.css
@@ -272,6 +272,20 @@ fieldset.bloc > legend + * { clear: both; }
 .creneau-legende { font-size: 12.5px; font-weight: 650; padding: 3px 10px; border-radius: 999px; }
 .grille-planning { display: grid; gap: 18px; align-items: start; }
 @media (min-width: 1280px) { .grille-planning { grid-template-columns: minmax(0, 1fr) 360px; } }
+
+/* La confirmation flotte au-dessus de la vue et laisse les commandes cliquables. */
+#notification-affectation:not(:empty) {
+  position: fixed; z-index: 50; top: 20px; right: 20px;
+  max-width: min(380px, calc(100% - 40px));
+  padding: 12px 16px; border: 1px solid var(--vert-700); border-radius: 10px;
+  background: var(--vert-100); color: var(--vert-900);
+  box-shadow: var(--ombre-2); font-weight: 700; pointer-events: none;
+}
+@media (max-width: 767px) {
+  #notification-affectation:not(:empty) {
+    top: calc(72px + env(safe-area-inset-top)); inset-inline: 12px; max-width: none;
+  }
+}
 .planning-vue { min-width: 0; }
 .planning-grille { display: none; background: #fff; border: 1px solid var(--ligne); border-radius: 16px; overflow: hidden; }
 .planning-grille__ligne { display: grid; grid-template-columns: 170px repeat(6, minmax(0, 1fr)); border-bottom: 1px solid var(--ligne); }
